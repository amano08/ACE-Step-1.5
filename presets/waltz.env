# 静かな3拍子・漸増構成のビッグバンド編曲（雪がしんしんと降り積もるイメージ）
# 2026-08-27 21:45 時点の画面の値を CDP で読み取って保存したもの。
#
# 3拍子は必ず TIMESIG=3 で渡す。キャプション本文の "3/4" は Auto ON だと
# ui_helpers.on_auto_checkbox_change に捨てられるので、ここが唯一のレバー。
#
# BPM 167 は原曲どおりの4分音符基準。3拍子なので1小節あたり約56で、
# 譜面は速くても体感はゆったりした1拍子になる。キャプション側で "slow" と
# 書くと 167 と衝突するため、静けさは音量と編成の語で表現している。
#
# キャプションは DiT テキストエンコーダで 256 トークンに切られる。
# text_prompt = 指示 + Caption + Metas の順で、Metas が最後にあるため、
# キャプションが長いと BPM/拍子/キー が丸ごと落ちる（conditioning_text.py:116-133）。
# 骨組みだけで 57 トークン使うので、キャプションは 200 トークン以下に保つこと。
ACESTEP_DEFAULT_CAPTION_FILE=presets/caption_waltz.txt
# Remix(cover) は DIRECT_CONDITIONING_TASKS に含まれ LM を丸ごとスキップするので、
# このネガティブプロンプトは効かない。text2music に戻したときだけ意味がある。
ACESTEP_DEFAULT_NEGATIVE_PROMPT_FILE=presets/negative_waltz.txt
ACESTEP_DEFAULT_BPM=167
ACESTEP_DEFAULT_TIMESIG=3
# キーは Auto（原曲の調が不明なため固定しない）。判明したら下行を有効化する。
# ACESTEP_DEFAULT_KEYSCALE="Bb major"
# 尺は -1（Auto）運用。ユーザーが毎回手動で -1 にしているため固定しない。

# --- 拡散パラメータ ---
# xl-sft は蒸留モデルではなく、設計上の推論ステップ数は 50
# （model_config.py:130 / training_v2/model_discovery.py:27）。
ACESTEP_DEFAULT_STEPS=50
# CFG は cover でもテキスト方向だけを分離して効く。dit_generate.py の CFG は
# enc_hs だけを null 化し ctx は両ブランチ同一なので、guidance はテキストの寄与そのもの。
# スライダー上限が 15.0 なので、これは振り切った値。
ACESTEP_DEFAULT_GUIDANCE_SCALE=15

# --- リミックス強度 / カバー強度 ---
# リミックス強度: cover_steps = int(num_steps * これ)。この比率を超えたステップは
# テキストのみの非cover分岐に切り替わる（dit_generate.py:326,424）。
ACESTEP_DEFAULT_REMIX_STRENGTH=0.15
# カバー強度: 原曲を再ノイズ化した地点からサンプラーを開始する img2img 的な強度。
# 0.15 → shift=3, 50ステップのスケジュールの高t側がほぼ全部残るので、
# 和声・旋律を作り替える余地が残る。
ACESTEP_DEFAULT_COVER_STRENGTH=0.15

# --- 音源 ---
# gradio の一時ディレクトリは消えるので presets/ にコピー済み。
# リファレンスは encoder 側（テキストと同じ束）に入るスタイル参照。
# process_reference_audio は 3x10秒を抜き出すため、ちょうど30秒だと
# randint(0,0) となり切り出しが完全に決定的になる。このファイルは 30.000 秒。
ACESTEP_DEFAULT_REFERENCE_AUDIO=presets/reference_waltz.mp3
ACESTEP_DEFAULT_SOURCE_AUDIO=presets/source_kitano.mp3
