# ビッグバンド・バラード（ゲームBGMのインスト編曲）
# 拍子とテンポは専用フィールドで固定する。キャプション本文に "4/4" や "62 BPM"
# と書いても、Auto が ON の間は ui_helpers.on_auto_checkbox_change が値を空へ
# 戻すため効かない。
#
# キャプションは 256 トークン上限。Metas が最後なので、超えると BPM/拍子が落ちる。
# 骨組みで 57 トークン。キャプションは 200 トークン以下に保つこと。
ACESTEP_DEFAULT_CAPTION_FILE=presets/caption_ballad.txt
# Remix(cover) では LM がスキップされるためネガティブプロンプトは効かない。
ACESTEP_DEFAULT_NEGATIVE_PROMPT_FILE=presets/negative_ballad.txt
ACESTEP_DEFAULT_BPM=62
ACESTEP_DEFAULT_TIMESIG=4
# キーは Auto（原曲の調が不明なため固定しない）。
# ACESTEP_DEFAULT_KEYSCALE="Bb major"
# 尺は Auto のまま。固定したいときだけ秒数を入れる。
# ACESTEP_DEFAULT_DURATION=180
